<Window x:Class="SafeShutdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SafeShutdown"
        Title="SafeShutdown · 服务器断电保护"
        Width="1180" Height="820" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:BoolToOnlineStatusConverter x:Key="OnlineStatusConverter" />
        <local:BoolToStatusBrushConverter x:Key="OnlineBrushConverter" />
        <local:PasswordMaskConverter x:Key="PasswordMaskConverter" />

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="TextBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#EEF2F7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DataGridTextElementStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="DataGridTextEditingStyle" TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CenteredColumnHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="CenteredCheckBoxStyle" TargetType="CheckBox"
               BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SafeShutdown" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="服务器断电保护与安全关机" Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{Binding MonitoringIndicatorBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding MonitoringStatus}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,18,22,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="132" />
                <RowDefinition Height="*" />
                <RowDefinition Height="176" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" CornerRadius="25" Background="{Binding PowerStatusBackground}" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="市电状态" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding PowerStatus}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding PowerStatusBrush}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding PowerStatusDetail}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="已启用主机" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding ServerSummary}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding OnlineSummary}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="连续失败" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding FailureSummary}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding LastCheckText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="18,12">
                    <StackPanel VerticalAlignment="Center">
                        <Button x:Name="MonitorButton" Style="{StaticResource PrimaryButtonStyle}"
                                Height="42" Padding="14,7" Content="{Binding MonitorActionText}"
                                Click="MonitorButton_Click" Margin="0,0,0,8" />
                        <Button x:Name="ManualShutdownButton" Style="{StaticResource DangerButtonStyle}"
                                Height="42" Padding="14,7" Content="关闭所有主机"
                                Click="ManualShutdownButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="16,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="远程主机" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="  按列表顺序执行延时与命令" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="＋ 添加" Click="AddItem_Click" Margin="0,0,6,0" Padding="10,6" />
                                <Button Content="删除" Click="DeleteItem_Click" Margin="0,0,6,0" Padding="10,6" />
                                <Button Content="↑" ToolTip="上移" Click="MoveUpItem_Click" Margin="0,0,4,0" Padding="10,6" />
                                <Button Content="↓" ToolTip="下移" Click="MoveDownItem_Click" Padding="10,6" />
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="ServerDataGrid" Grid.Row="1"
                                  ItemsSource="{Binding Config.Servers}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2F7"
                                  BorderThickness="0" Background="White" RowBackground="White"
                                  AlternatingRowBackground="#FAFCFF" HeadersVisibility="Column"
                                  RowHeight="42" ColumnHeaderHeight="46"
                                  IsReadOnly="{Binding IsBusy}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="58"
                                                        HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                                        ElementStyle="{StaticResource CenteredCheckBoxStyle}"
                                                        EditingElementStyle="{StaticResource CenteredCheckBoxStyle}" />
                                <DataGridTemplateColumn Header="状态" Width="74" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{Binding IsOnline, Converter={StaticResource OnlineBrushConverter}}" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding IsOnline, Converter={StaticResource OnlineStatusConverter}}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="IP / 主机名" Binding="{Binding IP, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="115"
                                                    ElementStyle="{StaticResource DataGridTextElementStyle}" EditingElementStyle="{StaticResource DataGridTextEditingStyle}" />
                                <DataGridTextColumn Header="端口" Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="68"
                                                    ElementStyle="{StaticResource DataGridTextElementStyle}" EditingElementStyle="{StaticResource DataGridTextEditingStyle}" />
                                <DataGridTextColumn Header="用户名" Binding="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                    ElementStyle="{StaticResource DataGridTextElementStyle}" EditingElementStyle="{StaticResource DataGridTextEditingStyle}" />
                                <DataGridTemplateColumn Header="密码" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Password, Converter={StaticResource PasswordMaskConverter}}" Foreground="{StaticResource MutedTextBrush}" Margin="10,0" VerticalAlignment="Center" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <PasswordBox Loaded="PasswordBox_Loaded" PasswordChanged="PasswordBox_PasswordChanged" Padding="5" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="关机命令" Binding="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Width="1.25*" MinWidth="120"
                                                    ElementStyle="{StaticResource DataGridTextElementStyle}" EditingElementStyle="{StaticResource DataGridTextEditingStyle}" />
                                <DataGridTextColumn Header="延时(秒)" Binding="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" Width="78"
                                                    ElementStyle="{StaticResource DataGridTextElementStyle}" EditingElementStyle="{StaticResource DataGridTextEditingStyle}" />
                                <DataGridCheckBoxColumn Header="sudo" Binding="{Binding UseSudo, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                                        HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                                        ElementStyle="{StaticResource CenteredCheckBoxStyle}"
                                                        EditingElementStyle="{StaticResource CenteredCheckBoxStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="监控设置" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="用持续供电设备的地址判断市电状态" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,14" />

                            <TextBlock Text="监控 IP / 主机名" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Config.MonIP, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="间隔（秒）" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Config.MonitorIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="失败阈值" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Config.FailureThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ping 超时(ms)" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Config.PingTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="断电缓冲(秒)" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Config.OutageGracePeriodSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="本机关机延时（秒）" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,5" />
                            <TextBox Text="{Binding Config.LocalShutdownDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Content="启动后自动开始监控" IsChecked="{Binding Config.AutoStartMonitoring}" Margin="0,14,0,0" />
                            <CheckBox Content="远程主机完成后关闭本机" IsChecked="{Binding Config.ShutdownLocalComputer}" Margin="0,8,0,0" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="测试 SSH" Click="TestSshButton_Click" />
                                <Button Grid.Column="2" Content="保存配置" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="运行日志" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="  最近 500 条" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CancelShutdownButton" Content="取消关机流程" Click="CancelShutdownButton_Click"
                                    Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="打开日志目录" Click="OpenLogsButton_Click" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="清空" Click="ClearLogsButton_Click" Padding="10,5" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True"
                             BorderThickness="0" Background="#0F172A" Foreground="#D7E2F0"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="14,10"
                             VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding FooterStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="配置会自动兼容旧版 Config.json" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
